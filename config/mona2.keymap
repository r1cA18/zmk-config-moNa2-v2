#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "gesture/tab_gesture.dtsi"

#define MAIN 0
#define LOWER 1
#define RAISE 2
#define CONTROL 3
#define MOUSE 4
#define SCROLL 5
#define GESTURE 6

&lt {
    tapping-term-ms = <200>;
    hold-trigger-on-release;
};

/ {
    behaviors {
        HRM: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <250>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;

            display-name = "HRM";
        };

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };

    macros {
        input_userid: input_userid {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8>;
        };

        input_email_proton: input_email_proton {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp N1 &kp C &kp LS(A) &kp N1 &kp N8 &kp AT &kp P &kp R &kp O &kp T &kp O &kp N &kp DOT &kp M &kp E>;
        };

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to MAIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        main_layer {
            display-name = "Main";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp Q                  &kp L     &kp U            &kp COMMA            &kp DOT                                               &kp F        &kp W  &kp R  &kp Y  &lt GESTURE P
&kp E                  &kp I     &HRM LEFT_ALT A  &HRM LS(LEFT_GUI) O  &HRM LEFT_CONTROL MINUS                &kp ESC        &kp K        &kp T  &kp N  &kp S  &lt SCROLL H
&HRM LEFT_SHIFT Z      &kp X     &kp C            &kp V                &kp SEMI                 &kp K_MUTE    &kp LC(T)      &kp G        &kp D  &kp M  &kp J  &HRM RIGHT_SHIFT B
&SandS LEFT_GUI LANG2  &kp LEFT  &kp RIGHT        &lt 3 LG(W)          &lt 2 SPACE              &lt 1 TAB     &kp BACKSPACE  &lt 2 ENTER                             &SandS RA(RIGHT_GUI) LANG1
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                        &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS  &kp PRCNT
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5             &kp CARET  &kp N6    &kp N7     &kp N8    &kp N9    &kp N0
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans    &trans     &kp F11   &kp F12    &trans    &trans    &kp DLLR
&trans  &trans  &trans  &trans  &trans   &trans    &trans     &trans                                   &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&kp QMARK  &kp EXCL   &kp AMPS  &kp PIPE  &kp BSLH                        &kp FSLH  &kp EQUAL  &kp STAR  &kp PLUS   &kp PRCNT
&kp POUND  &kp GRAVE  &kp DQT   &kp SQT   &kp TILDE            &kp CARET  &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT  &kp COLON
&kp AT     &kp LT     &kp LBRC  &kp LBKT  &kp LPAR   &trans    &trans     &kp RPAR  &kp RBKT   &kp RBRC  &kp GT     &kp DLLR
&trans     &trans     &trans    &trans    &trans     &trans    &trans     &trans                                    &trans
            >;
        };

        control_layer {
            display-name = "Ctrl";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp LG(MINUS)   &kp LG(PLUS)  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP                        &trans         &trans               &trans  &trans  &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &trans  &trans         &trans               &trans  &trans  &trans
&bt BT_CLR_ALL  &out OUT_USB  &out OUT_TOG  &out OUT_BLE  &trans        &bt BT_CLR    &trans  &input_userid  &input_email_proton  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans  &trans                                              &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &mkp MB5  &trans    &mkp MB4  &trans  &trans    &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans                                &trans
            >;
        };

        scroll_layer {
            display-name = "Scroll";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        gesture_layer {
            display-name = "Gesture";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };
    };
};
